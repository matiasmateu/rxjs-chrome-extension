{
  "name": "@rxjs-devtools/workspace",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck --filter=@rxjs-devtools/playground --filter=@rxjs-devtools/core --filter=@rxjs-devtools/panel-ui",
    "typecheck:legacy": "turbo run typecheck --filter=@rxjs-devtools/extension",
    "typecheck:all": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "build:extension": "npm run build --workspace @rxjs-devtools/extension",
    "dev:extension": "npm run dev --workspace @rxjs-devtools/extension",
    "dev:playground": "npm run dev --workspace @rxjs-devtools/playground"
  },
  "devDependencies": {
    "turbo": "^2.0.14"
  }
}
