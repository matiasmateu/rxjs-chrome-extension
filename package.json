{
  "name": "@rxjs-devtools/workspace",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:extension": "turbo run typecheck --filter=@rxjs-devtools/extension",
    "typecheck:legacy": "pnpm typecheck:extension",
    "typecheck:all": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "clean": "turbo run clean",
    "build:extension": "pnpm --filter @rxjs-devtools/extension build",
    "dev:extension": "pnpm --filter @rxjs-devtools/extension dev",
    "dev:playground": "pnpm --filter @rxjs-devtools/playground dev",
    "bump:patch": "npm --prefix packages/core version patch --no-git-tag-version",
    "bump:minor": "npm --prefix packages/core version minor --no-git-tag-version",
    "bump:major": "npm --prefix packages/core version major --no-git-tag-version"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.0.14"
  }
}
