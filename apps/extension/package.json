{
  "name": "@rxjs-devtools/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured for extension'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rxjs-devtools/core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
