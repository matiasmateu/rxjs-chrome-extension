{
  "manifest_version": 3,
  "name": "RxJS DevTools",
  "version": "0.1.0",
  "description": "Real-time RxJS marbles for redux-observable",
  "devtools_page": "devtools.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["contentScript.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["injectedHook.js"],
    "matches": ["<all_urls>"]
  }]
}