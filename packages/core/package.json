{
  "name": "rxjs-monitor",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./protocol": {
      "types": "./dist/types/protocol.d.ts",
      "import": "./dist/esm/protocol.js",
      "require": "./dist/cjs/protocol.cjs",
      "default": "./dist/esm/protocol.js"
    },
    "./monitor-rx": {
      "types": "./dist/types/monitor-rx.d.ts",
      "import": "./dist/esm/monitor-rx.js",
      "require": "./dist/cjs/monitor-rx.cjs",
      "default": "./dist/esm/monitor-rx.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0 --ext .ts",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "version": "node scripts/sync-extension-manifest-version.mjs"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "rxjs": "^7.8.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
